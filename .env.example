# Docker Compose only. Copy to .env locally and choose a password before launch.
POSTGRES_PASSWORD=change-this-local-password
# Direct backend development defaults to SQLite in apps/api/aegisrisk.db.
# To use PostgreSQL instead, export DATABASE_URL=postgresql+psycopg://aegisrisk:YOUR_PASSWORD@127.0.0.1:5432/aegisrisk
# Frontend proxy defaults to API_BASE_URL=http://127.0.0.1:8000
